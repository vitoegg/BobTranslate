{
  "identifier": "com.vitoegg.vercel.bobtranslate",
  "version": "0.1.1",
  "category": "translate",
  "name": "Vercel AI 翻译",
  "summary": "使用 Vercel AI 的 Bob 翻译插件。",
  "icons": [
    {
      "identifier": "vercel",
      "type": "file",
      "filePath": "icon.png"
    },
    {
      "identifier": "meta",
      "type": "file",
      "filePath": "meta.png"
    },
    {
      "identifier": "130",
      "type": "builtIn",
      "builtInId": "130"
    },
    {
      "identifier": "127",
      "type": "builtIn",
      "builtInId": "127"
    },
    {
      "identifier": "124",
      "type": "builtIn",
      "builtInId": "124"
    },
    {
      "identifier": "134",
      "type": "builtIn",
      "builtInId": "134"
    }
  ],
  "author": "vitoegg",
  "homepage": "https://github.com/vitoegg/BobTranslate",
  "appcast": "https://github.com/vitoegg/BobTranslate/releases/latest/download/vercel.json",
  "minBobVersion": "1.14.0",
  "options": [
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key",
      "textConfig": {
        "type": "secure",
        "placeholderText": "请输入 Vercel AI API Key"
      }
    },
    {
      "title": "模型",
      "identifier": "model",
      "type": "menu",
      "defaultValue": "meta/muse-spark-1.2-contributor",
      "menuValues": [
        {
          "title": "Qwen3.8 27B",
          "value": "alibaba/qwen3.8-27b",
          "defaultPluginName": "Qwen 翻译",
          "defaultPluginIconIdentifier": "130"
        },
        {
          "title": "Gemini 3.7 Flash",
          "value": "google/gemini-3.7-flash",
          "defaultPluginName": "Gemini 翻译",
          "defaultPluginIconIdentifier": "127"
        },
        {
          "title": "Muse Spark 1.2",
          "value": "meta/muse-spark-1.2-contributor",
          "defaultPluginName": "Meta 翻译",
          "defaultPluginIconIdentifier": "meta"
        },
        {
          "title": "GPT 5.6 Luna",
          "value": "openai/gpt-5.6-luna",
          "defaultPluginName": "OpenAI 翻译",
          "defaultPluginIconIdentifier": "124"
        },
        {
          "title": "Deepseek V4 Flash",
          "value": "deepseek/deepseek-v4-flash-0731",
          "defaultPluginName": "DeepSeek 翻译",
          "defaultPluginIconIdentifier": "134"
        },
        {
          "title": "自定义模型",
          "value": "custom",
          "defaultPluginName": "Vercel AI 翻译",
          "defaultPluginIconIdentifier": "vercel"
        }
      ],
      "isKeyOption": true
    },
    {
      "identifier": "customModel",
      "type": "text",
      "title": "自定义模型",
      "textConfig": {
        "type": "visible",
        "placeholderText": "例如：anthropic/claude-opus-5"
      },
      "desc": "仅在「模型」选择「自定义模型」时生效。"
    },
    {
      "identifier": "reasoningEffort",
      "type": "menu",
      "title": "深度思考",
      "defaultValue": "none",
      "menuValues": [
        {
          "title": "禁用思考",
          "value": "none"
        },
        {
          "title": "低",
          "value": "low"
        },
        {
          "title": "中",
          "value": "medium"
        },
        {
          "title": "高",
          "value": "high"
        }
      ],
      "desc": "默认禁用模型思考。"
    },
    {
      "identifier": "maxTokens",
      "type": "menu",
      "title": "最大输出 token 数",
      "defaultValue": "1024",
      "menuValues": [
        {
          "title": "512 tokens",
          "value": "512"
        },
        {
          "title": "1024 tokens",
          "value": "1024"
        },
        {
          "title": "2048 tokens",
          "value": "2048"
        },
        {
          "title": "4096 tokens",
          "value": "4096"
        }
      ],
      "desc": "用于限制返回结果的最大输出 token 数量。"
    },
    {
      "identifier": "temperature",
      "type": "menu",
      "title": "温度",
      "defaultValue": "0",
      "menuValues": [
        {
          "title": "0.0",
          "value": "0"
        },
        {
          "title": "0.2",
          "value": "0.2"
        },
        {
          "title": "0.5",
          "value": "0.5"
        },
        {
          "title": "1.0",
          "value": "1"
        }
      ],
      "desc": "温度越低，结果越稳定。"
    }
  ]
}
